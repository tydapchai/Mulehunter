  <diagram id="MuleHunter_Context_Diagram" name="MuleHunter AI - System Context Diagram (Level 0)">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="950" background="#F8FAFC" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE BLOCK -->
        <mxCell id="title_block" value="&lt;b style=&quot;font-size: 20px;&quot;&gt;SYSTEM CONTEXT DIAGRAM (LEVEL 0): MULEHUNTER AI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; color: #64748B;&quot;&gt;Hệ thống Đồ thị Trí tuệ Nhân tạo Liên ngân hàng Phát hiện Mạng lưới Rửa tiền &amp;amp; Tài khoản Rác Thời gian thực&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="275" y="20" width="800" height="50" as="geometry" />
        </mxCell>

        <!-- BOUNDARY / SYSTEM UNDER CONSIDERATION (CENTER) -->
        <mxCell id="core_system" value="&lt;div style=&quot;font-size: 16px; font-weight: bold; margin-bottom: 6px;&quot;&gt;MULEHUNTER AI SYSTEM&lt;/div&gt;&lt;div style=&quot;font-size: 12px; line-height: 1.4;&quot;&gt;&lt;b&gt;Trung tâm Phân tích &amp;amp; Giám sát Đồ thị Liên ngân hàng&lt;/b&gt;&lt;br&gt;• In-Memory Dynamic Graph (Memgraph)&lt;br&gt;• Real-time GNN Inference Engine (ONNX)&lt;br&gt;• SLA Ra quyết định: &amp;lt; 500ms&lt;br&gt;• Federated Graph Learning Coordinator&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0F172A;strokeWidth=3;fontColor=#FFFFFF;arcSize=10;shadow=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="475" y="340" width="400" height="190" as="geometry" />
        </mxCell>

        <!-- EXTERNAL ENTITY 1: NAPAS & VIETQR GATEWAY (TOP) -->
        <mxCell id="entity_napas" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;CỔNG CHUYỂN MẠCH QUỐC GIA&lt;br&gt;(NAPAS / VIETQR 247)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;Hạ tầng định tuyến giao dịch liên ngân hàng&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284C7;strokeColor=#0369A1;strokeWidth=2;fontColor=#FFFFFF;arcSize=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="535" y="100" width="280" height="85" as="geometry" />
        </mxCell>

        <!-- EXTERNAL ENTITY 2: CORE BANKING SYSTEMS (LEFT) -->
        <mxCell id="entity_banks" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;CÁC NGÂN HÀNG THÀNH VIÊN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;(Vietcombank, MB, Techcombank...)&lt;br&gt;Core Banking &amp;amp; Hệ thống AML Nội bộ&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#1D4ED8;strokeWidth=2;fontColor=#FFFFFF;arcSize=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="380" width="260" height="110" as="geometry" />
        </mxCell>

        <!-- EXTERNAL ENTITY 3: REGULATORS & LAW ENFORCEMENT (RIGHT) -->
        <mxCell id="entity_regulators" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;CƠ QUAN QUẢN LÝ &amp;amp; PHÁP LUẬT&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;• Ngân hàng Nhà nước (Cục PCRT)&lt;br&gt;• Cục An ninh mạng A05 - Bộ Công an&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DC2626;strokeColor=#B91C1C;strokeWidth=2;fontColor=#FFFFFF;arcSize=8;shadow=1;" vertex="1" parent="1">
