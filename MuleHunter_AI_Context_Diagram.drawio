        <mxCell id="entity_biometrics" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;DỊCH VỤ SINH TRẮC HỌC ĐỘNG&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;(Dynamic Step-up Biometrics Engine)&lt;br&gt;Theo chuẩn Quyết định 2345/QĐ-NHNN&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#047857;strokeWidth=2;fontColor=#FFFFFF;arcSize=8;shadow=1;" vertex="1" parent="1">
