        </mxCell>

        <!-- EXTERNAL ENTITY 4: COMPLIANCE & FRAUD INVESTIGATOR (BOTTOM LEFT) -->
        <mxCell id="entity_analyst" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;CHUYÊN VIÊN ĐIỀU TRA GIAN LẬN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;(Fraud Analysts &amp;amp; Compliance Officers)&lt;br&gt;Đội ngũ thanh tra liên ngân hàng&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#475569;strokeColor=#334155;strokeWidth=2;fontColor=#FFFFFF;arcSize=8;shadow=1;" vertex="1" parent="1">
