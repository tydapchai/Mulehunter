        <!-- DATA FLOW 1: NAPAS -> MULEHUNTER -->
        <mxCell id="flow_napas_in" value="Luồng giao dịch liên ngân hàng thời gian thực&lt;br&gt;(Kafka Stream: TxnID, Src, Dst, Amount, Timestamp)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.35;entryY=0;entryDx=0;entryDy=0;exitX=0.35;exitY=1;exitDx=0;exitDy=0;strokeColor=#0284C7;strokeWidth=2;fontColor=#0369A1;labelBackgroundColor=#F8FAFC;fontSize=11;" edge="1" parent="1" source="entity_napas" target="core_system">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DATA FLOW 2: MULEHUNTER -> NAPAS -->
        <mxCell id="flow_napas_out" value="Quyết định kiểm soát &amp;lt; 500ms&lt;br&gt;(ALLOW / CHALLENGE / BLOCK_HOLD)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.65;entryY=1;entryDx=0;entryDy=0;exitX=0.65;exitY=0;exitDx=0;exitDy=0;strokeColor=#DC2626;strokeWidth=2;fontColor=#B91C1C;labelBackgroundColor=#F8FAFC;fontSize=11;fontStyle=1;" edge="1" parent="1" source="core_system" target="entity_napas">
