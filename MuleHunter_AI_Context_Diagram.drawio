          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DATA FLOW 5: REGULATORS -> MULEHUNTER -->
        <mxCell id="flow_reg_in" value="• Danh sách đen tài khoản tội phạm (Blacklist)&lt;br&gt;• Quy định AML &amp;amp; Ngưỡng giám sát" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.35;entryDx=0;entryDy=0;exitX=0;exitY=0.35;exitDx=0;exitDy=0;strokeColor=#475569;strokeWidth=2;fontColor=#334155;labelBackgroundColor=#F8FAFC;fontSize=11;" edge="1" parent="1" source="entity_regulators" target="core_system">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DATA FLOW 6: MULEHUNTER -> REGULATORS -->
        <mxCell id="flow_reg_out" value="• Báo cáo Giao dịch Đáng ngờ (Automated STR)&lt;br&gt;• Đồ thị chứng cứ chuỗi rửa tiền phục vụ phá án" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.7;entryDx=0;entryDy=0;exitX=1;exitY=0.7;exitDx=0;exitDy=0;strokeColor=#DC2626;strokeWidth=2;fontColor=#B91C1C;labelBackgroundColor=#F8FAFC;fontSize=11;fontStyle=1;" edge="1" parent="1" source="core_system" target="entity_regulators">
